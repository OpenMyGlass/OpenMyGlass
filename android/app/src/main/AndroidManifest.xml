<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TCP bridge transport (debug connection to sim-glass; Wi-Fi bridge to Glass later). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility for binding OsmAnd's AIDL service (Android 11+). -->
    <queries>
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.dev" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="OpenMyGlass">
        <activity
            android:name=".DebugActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notifications.OpenMyGlassNotificationListener"
            android:exported="true"
            android:label="OpenMyGlass"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
